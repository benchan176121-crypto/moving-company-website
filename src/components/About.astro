---
import { site } from "@data/site";
---

<section id="about" class="bg-jade-50 py-16">
  <div class="mx-auto max-w-6xl px-4">
    <div>
      <div class="section-heading left">
        <span>關於我們</span>
        <h2>{site.companyName}</h2>
      </div>
      <p class="mt-5 text-lg leading-9 text-slate-700">
        我哋主力做香港住宅搬屋、寫字樓搬遷、本地貨運、傢俬拆裝、包裝物料、存倉同棄置傢俬。老闆最怕搬屋報價唔清楚、臨場先話加錢，所以網站重點會引導客人先 WhatsApp 傳相，搬前講清楚物件、路線、樓層、人手同車輛安排。
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        {["先溝通", "先報價", "準時到場", "搬後跟進"].map((item) => (
          <span class="rounded-full bg-white px-4 py-2 text-sm font-bold text-jade-800 shadow-sm">{item}</span>
        ))}
      </div>
    </div>
  </div>
</section>
