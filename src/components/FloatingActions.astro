---
import { site } from "@data/site";
---

<div class="fixed bottom-3 left-3 right-3 z-50 grid grid-cols-2 gap-2 rounded-full bg-white/90 p-2 shadow-soft backdrop-blur sm:bottom-6 sm:left-auto sm:right-6 sm:flex sm:flex-col sm:bg-transparent sm:p-0 sm:shadow-none sm:backdrop-blur-0">
  <a class="rounded-full bg-[#25d366] px-5 py-3 text-center text-sm font-black text-white hover:brightness-95 sm:shadow-soft" href={site.whatsappHref} aria-label="WhatsApp 浮動按鈕">
    WhatsApp
  </a>
  <a class="rounded-full bg-ink px-5 py-3 text-center text-sm font-black text-white hover:bg-jade-700 sm:shadow-soft" href={site.phoneHref} aria-label="Click-to-call 按鈕">
    Call
  </a>
</div>
