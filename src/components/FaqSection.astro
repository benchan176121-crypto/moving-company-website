---
import { faqs } from "@data/faq";
---

<section id="faq" class="bg-white py-16">
  <div class="mx-auto max-w-4xl px-4">
    <div class="section-heading">
      <span>FAQ</span>
      <h2>常見問題</h2>
    </div>
    <div class="mt-8 divide-y divide-slate-200 rounded-lg border border-slate-200 bg-white">
      {faqs.map((faq) => (
        <details class="group p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-black text-ink">
            {faq.question}
            <span class="text-jade-700 group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 leading-8 text-slate-600">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
