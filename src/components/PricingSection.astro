---
import { extraCharges, pricingItems, pricingNotes } from "@data/pricing";
---

<section id="pricing" class="bg-jade-50 py-16">
  <div class="mx-auto max-w-6xl px-4">
    <div class="section-heading">
      <span>收費參考</span>
      <h2>先俾你有概念，正式價錢按資料確認</h2>
    </div>
    <div class="mt-8 grid gap-5 lg:grid-cols-4">
      {pricingItems.map((item) => (
        <article class="rounded-lg bg-white p-5 shadow-sm">
          <h3 class="text-xl font-black text-ink">{item.title}</h3>
          <p class="mt-4 text-2xl font-black text-jade-700">{item.price}</p>
          <p class="mt-3 leading-7 text-slate-600">{item.description}</p>
        </article>
      ))}
    </div>
    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      <div class="rounded-lg bg-white p-6 shadow-sm">
        <h3 class="text-xl font-black text-ink">報價提醒</h3>
        <ul class="mt-4 space-y-3 text-slate-700">
          {pricingNotes.map((note) => <li class="check-line">{note}</li>)}
        </ul>
      </div>
      <div class="rounded-lg bg-white p-6 shadow-sm">
        <h3 class="text-xl font-black text-ink">可能額外收費項目</h3>
        <ul class="mt-4 space-y-3 text-slate-700">
          {extraCharges.map((charge) => <li class="check-line">{charge}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
