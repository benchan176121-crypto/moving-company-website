---
import { quoteSteps } from "@data/services";
import { site } from "@data/site";
import { assetPath } from "@utils/paths";
---

<section id="quote-process" class="bg-white py-16">
  <div class="mx-auto max-w-6xl px-4">
    <div class="section-heading">
      <span>WhatsApp / 網上報價流程</span>
      <h2>三步俾到初步報價，減少來回追問</h2>
    </div>
    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      {quoteSteps.map((step) => (
        <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <img class="h-48 w-full rounded-md object-cover" src={assetPath(step.image)} width="900" height="650" alt={step.title} />
          <span class="mt-5 inline-flex rounded-full bg-jade-50 px-3 py-1 text-sm font-black text-jade-700">{step.step}</span>
          <h3 class="mt-3 text-xl font-black text-ink">{step.title}</h3>
          <p class="mt-2 leading-7 text-slate-600">{step.description}</p>
        </article>
      ))}
    </div>
    <div class="mt-8 rounded-lg bg-jade-900 p-6 text-white sm:flex sm:items-center sm:justify-between">
      <div>
        <h3 class="text-2xl font-black">想快啲？直接 WhatsApp 傳相</h3>
        <p class="mt-2 text-white/80">搬屋日期、地區、樓層、相片一齊發，最快可以估到大約價錢。</p>
      </div>
      <a class="mt-5 inline-flex rounded-full bg-amberline px-6 py-3 font-black text-ink hover:bg-white sm:mt-0" href={site.whatsappHref}>
        WhatsApp {site.phoneDisplay}
      </a>
    </div>
  </div>
</section>
