---
import { disposalServices } from "@data/services";
import { site } from "@data/site";
---

<section id="disposal" class="bg-ink py-16 text-white">
  <div class="mx-auto max-w-6xl px-4">
    <div class="section-heading light">
      <span>棄置傢俬服務</span>
      <h2>搬屋同時處理舊傢俬，少一樣麻煩</h2>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {disposalServices.map((item) => (
        <div class="rounded-lg bg-white/10 p-5 ring-1 ring-white/15">
          <p class="font-bold leading-7 text-white/90">{item}</p>
        </div>
      ))}
    </div>
    <a class="mt-8 inline-flex rounded-full bg-amberline px-6 py-3 font-black text-ink hover:bg-white" href={site.whatsappHref}>WhatsApp 影相問棄置費</a>
  </div>
</section>
