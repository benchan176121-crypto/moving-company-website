---
import { packingMaterials } from "@data/services";
import { assetPath } from "@utils/paths";
---

<section id="packing" class="bg-slate-50 py-16">
  <div class="mx-auto max-w-6xl px-4">
    <div class="section-heading">
      <span>包裝物料 Grid</span>
      <h2>常用搬屋包裝物料</h2>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {packingMaterials.map((item) => (
        <article class="overflow-hidden rounded-lg bg-white shadow-sm">
          <img class="h-56 w-full object-cover" src={assetPath(item.image)} width="900" height="650" alt={item.title} />
          <div class="p-5">
            <h3 class="text-xl font-black text-ink">{item.title}</h3>
            <p class="mt-2 leading-7 text-slate-600">{item.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
